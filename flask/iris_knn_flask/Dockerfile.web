# 화면 서버 이미지: 입력·결과 화면, VM에서 실행. 예측은 PREDICT_URL 연산 서버로 전달
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir flask==3.1.3 requests
COPY webserver.py .
COPY templates/ templates/
COPY static/ static/
ENV PREDICT_URL=http://192.168.24.106:8890/predict
EXPOSE 5000
CMD ["python", "webserver.py"]
